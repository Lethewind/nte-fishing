# Optional local overrides. Copy to .env; .env is ignored by git.
INPUT_FUNCTION=sendmessage
INPUT_ASSIGNMENT=ad
# Experimental: send WM_ACTIVATE/WM_SETFOCUS before background key-down.
SEND_ACTIVATION_HINTS=false
LOOP_INTERVAL=0.2
FISHING_LOOP_INTERVAL=0.033
SHOW_PREVIEW_WINDOW=true
STARTUP_DELAY_SEC=5

# Language -> window title aliases. Result templates use the fixed naming
# convention assets/click_bank_<lang>.png.
LANGUAGES=zh,zhtw
WINDOW_TITLES_ZH=异环,異環
WINDOW_TITLES_ZHTW=NTE

MARKER_TEMPLATE=assets/marker_template.png

RESULT_TEMPLATE_THRESHOLD=0.6
HOOK_TEMPLATE=assets/hook.png
HOOK_TEMPLATE_THRESHOLD=0.72
HOOK_BINARY_THRESHOLD=160
IDLE_PRESS_MIN_SEC=0.5
IDLE_PRESS_MAX_SEC=1.0
RESULT_ESC_COOLDOWN_SEC=3.0
SLIDER_MAX_DIST_RATIO=0.05
SLIDER_MERGE_GAP_MARKER_RATIO=2.0
MARKER_TEMPLATE_THRESHOLD=0.85
